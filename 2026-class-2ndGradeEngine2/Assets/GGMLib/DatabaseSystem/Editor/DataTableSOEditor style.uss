.validate-section
{
    margin-top: 8px;
}

.separator
{
    height:1px;
    background-color: rgba(128, 128, 128, 0.5);
    margin-bottom: 8px;
}

.validate-button
{
    margin-bottom: 6px;
    height: 28px;
    -unity-font-style: bold;
}

.result-scroll
{
    display: none;
    max-height: 200px;
    background-color: rgba(0,0,0,0.15);
    border-radius: 3px;
    border-color: rgba(128,128,128,0.4);
    border-width: 1px;
    padding: 4px;
}

.result-label
{
    white-space: normal;
    font-size: 12px;
}

.result-label--pass
{
    color: rgb(100, 220, 100);
}
.result-label--fail
{
    color: rgb(255, 120, 100);
}